@model TranscriptResult

@if (Model.Success)
{
    <section class="transcript" aria-labelledby="transcript-heading">
        <h2 id="transcript-heading">Transkription</h2>
        <label class="visually-hidden" for="transcript-text">Transkriberad text</label>
        <textarea id="transcript-text" rows="8">@Model.Text</textarea>
        <div class="actions">
            <button type="button" class="btn btn-primary"
                    onclick="navigator.clipboard.writeText(document.getElementById('transcript-text').value).then(() => this.textContent = 'Kopierat!')">
                Kopiera text
            </button>
            <button type="button" class="btn btn-secondary"
                    onclick="document.getElementById('result').replaceChildren()">
                Rensa
            </button>
        </div>
    </section>
}
else
{
    <div class="alert" role="alert">@Model.Text</div>
}
